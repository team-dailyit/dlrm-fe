{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // vite.config.ts · vitest.config.ts 처럼 Node 에서 도는 설정 파일용이다.
    "lib": ["ES2023"],
    "types": ["node"],

    // Node 에서 실행되므로 base 의 bundler 설정을 덮어쓴다.
    // module 과 moduleResolution 은 반드시 함께 바꿔야 한다.
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "allowImportingTsExtensions": true,

    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  }
}
